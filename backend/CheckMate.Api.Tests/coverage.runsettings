<?xml version="1.0" encoding="utf-8"?>
<!-- Listing the collector here makes every dotnet test run collect coverage, into TestResults/<run id>/. -->
<RunSettings>
  <DataCollectionRunSettings>
    <DataCollectors>
      <DataCollector friendlyName="XPlat Code Coverage">
        <Configuration>
          <Format>cobertura</Format>
          <!-- Source-generated code (such as the OpenAPI XML comment support) isn't ours to test, and Program.cs is
               startup wiring that unit tests don't run. -->
          <ExcludeByFile>**/obj/**,**/Program.cs</ExcludeByFile>
          <ExcludeByAttribute>GeneratedCodeAttribute,CompilerGeneratedAttribute</ExcludeByAttribute>
        </Configuration>
      </DataCollector>
    </DataCollectors>
  </DataCollectionRunSettings>
</RunSettings>
